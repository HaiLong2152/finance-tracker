# Cổng để chạy server Node.js
PORT=5000

# Cấu hình kết nối MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finance_tracker

# Cấu hình xác thực (SPEC 5.1 - BẮT BUỘC: Ứng dụng sẽ từ chối khởi động nếu thiếu)
# Mật khẩu người dùng duy nhất (dạng plain text hoặc bcrypt hash trong AUTH_PASSWORD_HASH)
AUTH_PASSWORD="your_secure_password"
# AUTH_PASSWORD_HASH=""

# Khóa bí mật dùng để ký token JWT (30 ngày) - BẮT BUỘC, sử dụng chuỗi ngẫu nhiên dài và bảo mật
JWT_SECRET="replace_with_a_long_random_secret_key"

# Domain Frontend được phép gọi API (phân cách bằng dấu phẩy nếu nhiều origin)
CORS_ORIGIN="http://localhost:5173"

