# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (FINANCE TRACKER)
# ==============================================================================

# URL gọi API cho Frontend
# Khi chạy cục bộ (Development) hoặc chạy chung tên miền sau Reverse Proxy (Nginx / Docker):
# Mặc định để trống hoặc '/api' để gọi cùng origin tương đối
VITE_API_URL=/api

# Khi deploy Frontend tách biệt với Backend (ví dụ: Vercel/Netlify gọi sang Render/Railway):
# Điền đường dẫn API đầy đủ của máy chủ Backend:
# VITE_API_URL=https://api-finance.yourdomain.com/api

