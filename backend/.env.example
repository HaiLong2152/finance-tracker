# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU (FINANCE TRACKER)
# Sao chép file này thành .env và chỉnh sửa các giá trị cho phù hợp
# ==============================================================================

# Môi trường chạy: 'development' | 'production' | 'test'
NODE_ENV=development

# Cổng lắng nghe của máy chủ Express
PORT=5000

# Cấu hình kết nối MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=finance_tracker

# Bật kết nối mã hóa SSL/TLS cho MySQL (SPEC 5.2 - khuyến nghị trong Production)
# DB_SSL=true
# DB_SSL_CA=/path/to/ca-cert.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Số ngày lưu trữ các bản sao lưu tự động trước khi xoay vòng xóa cũ (mặc định 7 ngày)
BACKUP_RETENTION_DAYS=7

# Mật khẩu quản trị ứng dụng (SPEC 5.1)
# Trong môi trường dev: có thể dùng mật khẩu văn bản thô
# Trong production: KHUYẾN CÁO dùng chuỗi hash bcrypt (tạo qua: node -e "console.log(require('bcryptjs').hashSync('mat_khau_cua_ban', 10))")
AUTH_PASSWORD=your_app_password
# AUTH_PASSWORD_HASH=$2a$10$... (Ưu tiên dùng thay cho AUTH_PASSWORD nếu được khai báo)

# Khóa bí mật ký JWT Token (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_super_secure_random_string_min_32_characters

# Token xác thực Ingest API từ ứng dụng điện thoại (Tối thiểu 16 ký tự ngẫu nhiên)
INGEST_TOKEN=replace_with_a_secure_ingest_token_min_16_characters

# Tên miền Frontend được phép gọi API qua CORS (nhiều domain phân cách bởi dấu phẩy)
# Ví dụ: http://localhost:5173,https://my-finance.example.com
CORS_ORIGIN=http://localhost:5173

# Cấu hình số lớp Reverse Proxy (Nginx, Cloudflare, Caddy, Render, v.v.)
# Đặt 1 nếu chạy sau 1 reverse proxy, hoặc 'true' nếu tin cậy proxy
TRUST_PROXY=1

# Giới hạn số lượng request chung trong 15 phút (mặc định 100)
RATE_LIMIT_MAX=100
